<template>
  <div class="page" ontouchstart="touchStart" ontouchend="touchEnd" ontouchcancel="cancelCharge">
    <text class="score">{{score}}</text>
    <text class="menu-button" onclick="toggleMenu">•••</text>
    <div for="p in platforms" tid="id" class="platform-side" style="{{p.sideStyle}}"></div>
    <div for="p in platforms" tid="id" class="platform-top" style="{{p.topStyle}}"></div>
    <div for="p in platforms" tid="id" class="platform-mark" style="{{p.markStyle}}"></div>
    <div class="shadow" style="{{shadowStyle}}"></div>
    <div class="landing-ring" style="{{ringStyle}}"></div>
    <div class="player" style="{{playerStyle}}">
      <div class="body" style="{{bodyStyle}}"></div>
      <div class="head" style="{{headStyle}}"></div>
    </div>
    <text class="reward" style="{{rewardStyle}}">{{rewardText}}</text>
    <text if="{{phase !== 'over' &amp;&amp; !menuOpen}}" class="hint">{{hint}}</text>
    <div if="{{phase === 'over' &amp;&amp; !menuOpen}}" class="result">
      <text class="result-title">{{hint}}</text>
      <text class="again" onclick="restart">再来一局</text>
    </div>
    <div if="{{menuOpen}}" class="menu">
      <text class="menu-title">跳一跳</text>
      <text class="record">最高纪录 {{best}}</text>
      <text class="setting" onclick="toggleHaptics">{{hapticAvailable ? (haptics ? '震动  开' : '震动  关') : '震动不可用'}}</text>
      <text class="setting" onclick="restart">重新开始</text>
      <text class="menu-help">按得越久，跳得越远</text>
      <text class="setting back" onclick="toggleMenu">继续游戏</text>
    </div>
  </div>
</template>
<script>
import page from './page';
export default page;
</script>
