      <text class="record">最高 {{best}} m</text>
      <text class="help">{{phase === 'over' ? '保持距离，再试一次' : '左右滑动，或点击下方左右侧'}}</text>
      <text if="{{phase !== 'paused'}}" class="button" onclick="start">{{phase === 'ready' ? '开始驾驶' : '再来一局'}}</text>
      <text if="{{phase === 'paused'}}" class="button" onclick="resume">继续驾驶</text>
    </div>
  </div>
</template>
