<template>
  <div class="page" ontouchstart="touchStart" ontouchend="touchEnd" ontouchcancel="cancelTouch">
    <div class="verge"></div><div class="road"></div>
    <div class="edge left"></div><div class="edge right"></div>
    <div for="m in marks" tid="id" class="mark" style="{{m.style}}"></div>
